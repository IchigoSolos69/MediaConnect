# MediaConnect Environment Configuration Template
# Copy this file to .env and fill in required secrets

# Database Configuration (SQLite local file by default)
DATABASE_URL="file:./dev.db"

# Mode configuration: 'mock' for local zero-cost testing, 'live' for real social APIs
NEXT_PUBLIC_SOCIAL_MODE="mock"

# Security Secrets (MANDATORY IN PRODUCTION)
# Generate with: openssl rand -hex 32
AUTH_SECRET="generate_32_byte_hex_secret_for_jwt_session_signing"
TOKEN_VAULT_KEY_V1="generate_64_char_hex_for_aes_256_gcm_token_vault"
TOKEN_VAULT_KEY_V2=""
TOKEN_VAULT_ACTIVE_VERSION="v1"
DISPATCH_SECRET="generate_32_byte_secret_for_internal_service_dispatch"

# Social Platform OAuth Credentials (Required only when NEXT_PUBLIC_SOCIAL_MODE="live")
# YOUTUBE_CLIENT_ID=""
# YOUTUBE_CLIENT_SECRET=""
# META_APP_ID=""
# META_APP_SECRET=""
# TWITTER_CLIENT_ID=""
# TWITTER_CLIENT_SECRET=""
# GEMINI_API_KEY=""
